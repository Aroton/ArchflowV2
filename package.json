{
  "name": "archflow-mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:contracts": "vitest run test/contracts",
    "test:mcp-runtime": "vitest run test/unit/mcp-*.test.ts test/integration/mcp-stdio.test.ts",
    "probe:phase4-mcp-compatibility": "node scripts/probe-phase-4-mcp-compatibility.mjs",
    "build:temp": "node scripts/build-temp.mjs",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "check:notices": "node scripts/check-notices.mjs",
    "test:notices-policy": "node scripts/test-notices-policy.mjs",
    "check:phase4-mcp-boundary": "node scripts/check-phase-4-mcp-boundary.mjs",
    "test:phase4-mcp-boundary-policy": "node scripts/test-phase-4-mcp-boundary-policy.mjs",
    "check": "npm run probe:phase4-mcp-compatibility && npm run typecheck && npm run test:mcp-runtime && npm test && npm run test:contracts && npm run build:temp && npm run check:dependencies && npm run check:notices && npm run test:notices-policy && npm run check:phase4-mcp-boundary && npm run test:phase4-mcp-boundary-policy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
