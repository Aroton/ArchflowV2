{
  "name": "archflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project fast",
    "test:unit": "vitest run --project fast test/unit",
    "test:contracts": "vitest run --project fast test/contracts",
    "test:extended": "vitest run --project extended",
    "test:integration": "vitest run --project integration",
    "test:real-host": "vitest run --project real-host",
    "release:stage": "node scripts/build-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:reproduce": "node scripts/reproduce-release.mjs",
    "release:write": "node scripts/write-tracked-release.mjs",
    "release:smoke": "node scripts/smoke-release-bundle.mjs",
    "release:mutations": "node scripts/test-release-integrity.mjs",
    "check:release": "node scripts/run-concurrent.mjs --exec \"npm run release:check -- --payload dist\" \"npm run release:smoke -- --payload dist\" \"npm run release:mutations\" \"npm run release:reproduce\"",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "check:schemas": "node scripts/generate-schemas.mjs --check",
    "check:notices": "node scripts/check-notices.mjs",
    "test:notices-policy": "node scripts/test-notices-policy.mjs",
    "check": "npm run typecheck && npm test && npm run check:notices",
    "check:deep": "npm run check && node scripts/run-concurrent.mjs --npm check:schemas test:notices-policy test:extended check:release && npm run test:integration"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
