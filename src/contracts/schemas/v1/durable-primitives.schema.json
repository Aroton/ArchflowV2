        },
        "constitution_root": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
        }
      },
      "required": [
        "task_root",
        "config",
        "state",
        "workflow",
        "constitution_root"
      ],
      "additionalProperties": false
