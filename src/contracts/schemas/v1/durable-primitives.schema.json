    "snapshotAccountingEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
            },
            "storage": {
              "type": "string",
              "const": "git-object"
            },
            "stored_bytes": {
              "type": "number",
              "const": 0
            }
          },
          "required": [
            "path",
            "storage",
            "stored_bytes"
          ],
          "additionalProperties": false
