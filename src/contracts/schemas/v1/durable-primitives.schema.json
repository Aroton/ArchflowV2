    "snapshotAccounting": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "result_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 26214400
        },
        "task_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144000
        },
        "result_byte_cap": {
          "type": "number",
          "const": 26214400
        },
        "task_byte_cap": {
          "type": "number",
          "const": 262144000
        },
        "counted_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshotAccountingEntry"
          }
        },
        "measured_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "result_bytes",
        "task_bytes",
        "result_byte_cap",
        "task_byte_cap",
        "counted_entries",
        "measured_at_revision"
