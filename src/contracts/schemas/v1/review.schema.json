{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:review",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "taskSlug": {
      "type": "string",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phaseInstance": {
      "type": "string",
      "pattern": "^(?:prd|design|phase-(?:design|impl)-[1-9][0-9]*)$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/id"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "defect",
            "risk",
            "gap",
            "preference"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "certain",
            "likely",
            "suspicion"
          ]
        },
        "falsifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "summary": {
          "$ref": "#/$defs/nonBlank"
        },
        "evidence": {
          "$ref": "#/$defs/nonBlank"
        },
        "suggested_resolution": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "required": [
        "finding_id",
        "claim_type",
        "confidence",
        "falsifier",
        "summary",
        "evidence",
        "suggested_resolution"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3"
    },
    "task_id": {
      "$ref": "#/$defs/taskSlug"
    },
    "phase_instance": {
      "$ref": "#/$defs/phaseInstance"
    },
    "step": {
      "type": "string",
      "const": "counter_review"
    },
    "role": {
      "type": "string",
      "enum": [
        "counter-review"
      ]
    },
    "subject_digest": {
      "$ref": "#/$defs/digest"
    },
    "input_fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "rubric_digest": {
      "$ref": "#/$defs/digest"
    },
    "producer_family": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "gemini"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "finding_id": {
                "$ref": "#/$defs/id"
              },
              "claim_type": {
                "type": "string",
                "enum": [
                  "defect",
                  "risk",
                  "gap",
                  "preference"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "certain",
                  "likely",
                  "suspicion"
                ]
              },
              "falsifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "summary": {
                "$ref": "#/$defs/nonBlank"
              },
              "evidence": {
                "$ref": "#/$defs/nonBlank"
              },
              "suggested_resolution": {
                "$ref": "#/$defs/nonBlank"
              },
              "criterion_id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "finding_id",
              "claim_type",
              "confidence",
              "falsifier",
              "summary",
              "evidence",
              "suggested_resolution",
              "criterion_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "finding_id": {
                "$ref": "#/$defs/id"
              },
              "criterion_id": {
                "$ref": "#/$defs/id"
              },
              "claim_type": {
                "type": "string",
                "enum": [
                  "defect",
                  "risk",
                  "gap",
                  "preference"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "certain",
                  "likely",
                  "suspicion"
                ]
              },
              "falsifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "required_behavior_or_risk_boundary": {
                "$ref": "#/$defs/nonBlank"
              },
              "coverage_or_oracle_problem": {
                "$ref": "#/$defs/nonBlank"
              },
              "consequence": {
                "$ref": "#/$defs/nonBlank"
              },
              "proposed_verification_change": {
                "$ref": "#/$defs/nonBlank"
              }
            },
            "required": [
              "finding_id",
              "criterion_id",
              "claim_type",
              "confidence",
              "falsifier",
              "required_behavior_or_risk_boundary",
              "coverage_or_oracle_problem",
              "consequence",
              "proposed_verification_change"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "upstream_alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "upstream_digest": {
            "$ref": "#/$defs/digest"
          },
          "drift": {
            "type": "string",
            "enum": [
              "aligned",
              "incidental",
              "material"
            ]
          },
          "affected_claim_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "rationale": {
            "$ref": "#/$defs/nonBlank"
          }
        },
        "required": [
          "upstream_digest",
          "drift",
          "affected_claim_ids",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "legacy_confirmations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "finding_id": {
                    "$ref": "#/$defs/id"
                  },
                  "status": {
                    "type": "string",
                    "const": "resolved"
                  },
                  "evidence": {
                    "$ref": "#/$defs/nonBlank"
                  }
                },
                "required": [
                  "finding_id",
                  "status",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "finding_id": {
                    "$ref": "#/$defs/id"
                  },
                  "claim_type": {
                    "type": "string",
                    "enum": [
                      "defect",
                      "risk",
                      "gap",
                      "preference"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "certain",
                      "likely",
                      "suspicion"
                    ]
                  },
                  "falsifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  "summary": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "evidence": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "suggested_resolution": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "criterion_id": {
                    "$ref": "#/$defs/id"
                  },
                  "status": {
                    "type": "string",
                    "const": "unresolved"
                  }
                },
                "required": [
                  "finding_id",
                  "claim_type",
                  "confidence",
                  "falsifier",
                  "summary",
                  "evidence",
                  "suggested_resolution",
                  "criterion_id",
                  "status"
                ],
                "additionalProperties": false
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "finding_id": {
                    "$ref": "#/$defs/id"
                  },
                  "status": {
                    "type": "string",
                    "const": "resolved"
                  },
                  "evidence": {
                    "$ref": "#/$defs/nonBlank"
                  }
                },
                "required": [
                  "finding_id",
                  "status",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "finding_id": {
                    "$ref": "#/$defs/id"
                  },
                  "criterion_id": {
                    "$ref": "#/$defs/id"
                  },
                  "claim_type": {
                    "type": "string",
                    "enum": [
                      "defect",
                      "risk",
                      "gap",
                      "preference"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "certain",
                      "likely",
                      "suspicion"
                    ]
                  },
                  "falsifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  "required_behavior_or_risk_boundary": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "coverage_or_oracle_problem": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "consequence": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "proposed_verification_change": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "status": {
                    "type": "string",
                    "const": "unresolved"
                  }
                },
                "required": [
                  "finding_id",
                  "criterion_id",
                  "claim_type",
                  "confidence",
                  "falsifier",
                  "required_behavior_or_risk_boundary",
                  "coverage_or_oracle_problem",
                  "consequence",
                  "proposed_verification_change",
                  "status"
                ],
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "phase_instance",
    "step",
    "role",
    "subject_digest",
    "input_fingerprint",
    "rubric_digest",
    "producer_family",
    "findings"
  ],
  "additionalProperties": false
}
