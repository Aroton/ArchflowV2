{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:effort-envelope",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2"
    },
    "instructions": {
      "type": "string",
      "const": "Select exactly one implementation profile for the phase design. Silently infer independently scoreable implementation components and score each 0-3 on A derivation depth, B verifier weakness, C state space, D specification uncertainty, and E codebase hazard; use the supplied hazard registry as repository context and include D in the sum without blocking. For each component: totals 0-2 select gemini-3-7-flash-high only when every axis is at most 1, the component is confidently short, and a long tool loop is confidently unnecessary; unknown short-task or loop suitability disqualifies Gemini. Otherwise totals 0-7 select gpt-5-6-sol-medium; totals 8-11 select gpt-6-astra-low; totals 12-15 select gpt-6-astra-high. Apply these floors after the total: A, C, or E equal to 3 requires at least gpt-6-astra-low; B and C both equal to 3 requires gpt-6-astra-high. Return the highest-ranked selected profile across all components in this order: gemini-3-7-flash-high, gpt-5-6-sol-medium, gpt-6-astra-low, gpt-6-astra-high. Never select Astra max. Specification uncertainty and coarse decomposition affect private scoring only: never critique the plan, report an issue, ask a question, return a blocker, or suggest a revision. Return only the bound profile identifier; do not return components, scores, totals, rationales, classifications, findings, or analysis."
    },
    "artifact": {
      "type": "string"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "phase_instance": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
    },
    "attempt": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    },
    "subject_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "input_fingerprint": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "invocation_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
    },
    "result_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
    },
    "policy_id": {
      "type": "string",
      "const": "implementation-agent-selector-v3"
    },
    "hazard_registry": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "state": {
          "type": "string",
          "enum": [
            "absent",
            "present"
          ]
        },
        "registry_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "primary"
                  },
                  {
                    "$ref": "urn:archflow:schema:v1:config#/$defs/repositoryName"
                  }
                ]
              },
              "path": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
              },
              "score": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "repository",
              "path",
              "score",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "state",
        "registry_digest",
        "hazards"
      ],
      "additionalProperties": false
    },
    "repositories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "const": "primary"
              },
              {
                "type": "string",
                "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
              }
            ]
          },
          "repository_identity_digest": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
          },
          "commit": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
          }
        },
        "required": [
          "name",
          "repository_identity_digest",
          "commit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "instructions",
    "artifact",
    "task_id",
    "phase_instance",
    "attempt",
    "subject_digest",
    "input_fingerprint",
    "invocation_id",
    "result_id",
    "policy_id",
    "hazard_registry",
    "repositories"
  ],
  "additionalProperties": false
}
