{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:effort-envelope",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3"
    },
    "instructions": {
      "type": "string",
      "const": "Assess only the implementation reasoning remaining after architecture and counter-reviewed phase design. Return one difficulty category and a concrete rationale; do not choose a model or use benchmark scores or costs to judge difficulty. Routine: follow specified steps, copy or validate files, wire established APIs, adapt known patterns, ordinary CRUD and UI composition. Bounded-reasoning: make local implementation decisions within a settled approach. Hard: substantial unresolved algorithmic reasoning or interacting correctness mechanisms remain to implement. Exceptional: deep derivation or difficult reasoning across multiple interacting mechanisms. Escalation must identify the concrete unresolved problem, not name a technical topic. Credit supplied algorithms, settled decisions, examples, and tested predecessor guarantees: calling a transaction API does not inherit the difficulty of inventing it. File counts, document length, copying volume, tool-loop duration, and test runtime do not increase difficulty. Security labels, timers, and shared state alone are not escalation reasons. Judge whether code is hard to get correct, how much is genuinely undefined, and what critical thought implementation still requires. Assess the phase as written, without assuming unplanned delegation or averaging away an essential difficult mechanism. If settling an unanswered design question or isolating hard work could reduce cost, explain it as advisory feedback. Return the bound difficulty and rationale only; never findings, blockers, model profiles, routes, or authority."
    },
    "artifact": {
      "type": "string"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "phase_instance": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
    },
    "attempt": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    },
    "subject_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "input_fingerprint": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "invocation_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
    },
    "result_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
    },
    "policy_id": {
      "type": "string",
      "const": "implementation-agent-selector-v5"
    },
    "hazard_registry": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "state": {
          "type": "string",
          "enum": [
            "absent",
            "present"
          ]
        },
        "registry_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "primary"
                  },
                  {
                    "$ref": "urn:archflow:schema:v1:config#/$defs/repositoryName"
                  }
                ]
              },
              "path": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
              },
              "score": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "repository",
              "path",
              "score",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "state",
        "registry_digest",
        "hazards"
      ],
      "additionalProperties": false
    },
    "repositories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "const": "primary"
              },
              {
                "type": "string",
                "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
              }
            ]
          },
          "repository_identity_digest": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
          },
          "commit": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
          }
        },
        "required": [
          "name",
          "repository_identity_digest",
          "commit"
        ],
        "additionalProperties": false
      }
    },
    "selection_input": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "catalog": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "string",
                  "const": "1"
                },
                "benchmark": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "captured_on": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "profiles": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "profile_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "model": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "effort": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "cost_group": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "qualifier": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "profile_id",
                      "model",
                      "cost_group",
                      "score"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "schema_version",
                "benchmark",
                "source",
                "captured_on",
                "profiles"
              ],
              "additionalProperties": false
            },
            "settings": {
              "type": "object",
              "properties": {
                "enabled_profiles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                  }
                },
                "cost_priority": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                  }
                },
                "minimum_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "difficulty_thresholds": {
                  "type": "object",
                  "properties": {
                    "routine": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "bounded-reasoning": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "hard": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "exceptional": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "routine",
                    "bounded-reasoning",
                    "hard",
                    "exceptional"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "enabled_profiles",
                "cost_priority",
                "minimum_score",
                "difficulty_thresholds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "catalog",
            "settings"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "explanation"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "instructions",
    "artifact",
    "task_id",
    "phase_instance",
    "attempt",
    "subject_digest",
    "input_fingerprint",
    "invocation_id",
    "result_id",
    "policy_id",
    "hazard_registry",
    "repositories",
    "selection_input"
  ],
  "additionalProperties": false
}
