{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:authority-link",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_kind", "assurance", "role", "task_id", "phase_instance", "subject_digest", "input_fingerprint", "evidence_digest", "authority"],
  "properties": {
    "schema_version": { "const": "1" }, "evidence_kind": { "enum": ["review", "adjudication"] }, "assurance": { "enum": ["agent-declared", "server-attested", "degraded"] },
    "role": { "enum": ["self-review", "counter-review", "gate-counter-review", "adjudication"] }, "task_id": { "$ref": "#/$defs/id" }, "phase_instance": { "$ref": "#/$defs/phase" },
    "subject_digest": { "$ref": "#/$defs/digest" }, "input_fingerprint": { "$ref": "#/$defs/digest" }, "evidence_digest": { "$ref": "#/$defs/digest" }, "gate_id": { "$ref": "#/$defs/id" },
    "authority": { "oneOf": [{ "$ref": "#/$defs/agent" }, { "$ref": "#/$defs/server" }, { "$ref": "#/$defs/degraded" }] }
  },
  "allOf": [
    { "if": { "properties": { "evidence_kind": { "const": "adjudication" } }, "required": ["evidence_kind"] }, "then": { "properties": { "role": { "const": "adjudication" } } }, "else": { "properties": { "role": { "enum": ["self-review", "counter-review", "gate-counter-review"] } } } },
    { "if": { "properties": { "assurance": { "const": "agent-declared" } }, "required": ["assurance"] }, "then": { "properties": { "authority": { "$ref": "#/$defs/agent" } } } },
    { "if": { "properties": { "assurance": { "const": "server-attested" } }, "required": ["assurance"] }, "then": { "properties": { "authority": { "$ref": "#/$defs/server" } } } },
    { "if": { "properties": { "assurance": { "const": "degraded" } }, "required": ["assurance"] }, "then": { "properties": { "authority": { "$ref": "#/$defs/degraded" } } } },
    { "if": { "properties": { "role": { "const": "gate-counter-review" } }, "required": ["role"] }, "then": { "properties": { "gate_id": true }, "required": ["gate_id"] }, "else": { "not": { "required": ["gate_id"] } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "phase": { "type": "string", "pattern": "^(?:prd|design|phase-(?:design|impl)-[1-9][0-9]*)$" }, "safe": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "agent": { "type": "object", "additionalProperties": false, "required": ["kind", "result_id", "result_digest", "state_revision"], "properties": { "kind": { "const": "agent-declared" }, "result_id": { "$ref": "#/$defs/id" }, "result_digest": { "$ref": "#/$defs/digest" }, "state_revision": { "$ref": "#/$defs/safe" } } },
    "server": { "type": "object", "additionalProperties": false, "required": ["kind", "invocation_id", "result_id", "receipt_id", "state_revision", "envelope_input_digest", "observed_output_digest", "result_digest"], "properties": { "kind": { "const": "server" }, "invocation_id": { "$ref": "#/$defs/id" }, "result_id": { "$ref": "#/$defs/id" }, "receipt_id": { "$ref": "#/$defs/id" }, "state_revision": { "$ref": "#/$defs/safe" }, "envelope_input_digest": { "$ref": "#/$defs/digest" }, "observed_output_digest": { "$ref": "#/$defs/digest" }, "result_digest": { "$ref": "#/$defs/digest" } } },
    "degraded": { "type": "object", "additionalProperties": false, "required": ["kind", "checkpoint_digest", "checkpoint_revision"], "properties": { "kind": { "const": "degraded" }, "checkpoint_digest": { "$ref": "#/$defs/digest" }, "checkpoint_revision": { "$ref": "#/$defs/safe" } } }
  }
}
