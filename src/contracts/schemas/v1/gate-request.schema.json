        "opened_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "const": "attempts-exhausted"
        },
        "context": {
          "type": "object",
          "properties": {
            "step": {
              "type": "string",
              "enum": [
                "produce",
                "counter_review",
                "triage",
                "adjudicate"
              ]
            },
            "attempts": {
              "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/safeInteger"
            },
            "maximum_attempts": {
              "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/safeInteger"
            },
            "review_push_through": {
              "type": "object",
              "properties": {
                "minimum_attempt": {
                  "type": "number",
                  "const": 2
                },
                "current_evidence_set_digest": {
                  "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
                },
                "triage_result_digest": {
                  "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
                },
                "accepted_occurrences": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "review_evidence_digest": {
                        "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
                      },
                      "finding_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                      }
                    },
                    "required": [
                      "review_evidence_digest",
                      "finding_id"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "minimum_attempt",
                "current_evidence_set_digest",
                "triage_result_digest",
                "accepted_occurrences"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "step",
            "attempts",
            "maximum_attempts",
            "review_push_through"
          ],
          "additionalProperties": false
        },
        "allowed_decisions": {
          "$ref": "#/$defs/reviewPushThroughDecisions"
        }
      },
      "required": [
        "schema_version",
        "gate_id",
        "intent_id",
        "request_digest",
        "task_id",
        "phase_instance",
        "summary",
        "subject_digest",
        "context_digest",
        "current_evidence",
