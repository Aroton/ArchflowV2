{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:gate-request",
  "$defs": {
    "currentEvidence": {
      "type": "object",
      "properties": {
        "set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slots": {
          "$ref": "urn:archflow:schema:v1:evidence-slots"
        }
      },
      "required": [
        "set_digest",
        "slots"
      ],
      "additionalProperties": false
    },
    "baselineObservation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "observation_kind": {
          "type": "string",
          "const": "projection-drift"
        },
        "task_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
        },
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "observed_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "drift_digest": {
          "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
        }
      },
      "required": [
        "schema_version",
        "observation_kind",
        "task_id",
        "phase_instance",
        "observed_at_revision",
        "drift_digest"
      ],
      "additionalProperties": false
    },
    "validationOverrideRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "evidence_kind": {
          "type": "string",
          "const": "validation-override-request"
        },
        "task_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
        },
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
        },
        "governing_phase_design_digest": {
          "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
        },
