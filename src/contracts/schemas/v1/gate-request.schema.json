{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:gate-request",
  "$defs": {
    "currentEvidence": {
      "type": "object",
      "properties": {
        "set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slots": {
          "$ref": "urn:archflow:schema:v1:evidence-slots"
        }
      },
      "required": [
        "set_digest",
        "slots"
      ],
      "additionalProperties": false
    },
    "supersession": {
      "type": "object",
      "properties": {
        "superseded_gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "accepted_triage_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "old_subject_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "superseded_gate_id",
        "accepted_triage_digest",
        "old_subject_digest"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "origin_gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "origin_decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin_context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
        },
        "phase_instance": {
          "type": "string",
          "pattern": "^(?:prd|design|phase-(?:design|impl)-[1-9][0-9]*)$"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_evidence_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule": {
          "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/rule"
        },
        "scope": {
          "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/waiverScope"
        }
      },
      "required": [
        "origin_gate_id",
        "origin_decision_digest",
        "origin_context_digest",
        "task_id",
        "phase_instance",
        "subject_digest",
        "current_evidence_set_digest",
        "rule",
        "scope"
      ],
      "additionalProperties": false
    },
    "waiverContext": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "origin",
        "rationale"
      ],
      "additionalProperties": false
    },
    "artifactApprovalDecisions": {
      "const": [
        "approve",
        "revise",
        "reject",
        "cancel"
      ]
    },
    "reviewTriggerDecisions": {
      "const": [
        "approve",
        "revise",
        "reject",
        "waiver-requested",
        "cancel"
      ]
    },
    "materialDriftDecisions": {
      "const": [
        "amend-upstream",
        "revise-current",
        "reject",
        "cancel"
      ]
    },
    "adjudicationFailureDecisions": {
      "const": [
        "approve",
        "revise",
        "reject",
        "waiver-requested",
        "cancel"
      ]
    },
    "attemptsExhaustedDecisions": {
      "const": [
        "retry-once",
        "revise",
        "abort",
        "cancel"
      ]
    },
    "constitutionEditDecisions": {
      "const": [
        "revert-edit",
        "start-base-amendment",
        "abort",
        "cancel"
      ]
    },
    "commitAuthorizationDecisions": {
      "const": [
        "authorize-commit",
        "revise",
        "abort",
        "cancel"
      ]
    },
    "restoreCollisionDecisions": {
      "const": [
        "discard-and-restore",
        "adopt-as-new-generation",
        "abort",
        "cancel"
      ]
    },
    "migrationAuditDecisions": {
      "const": [
        "accept-import-audit",
        "revise",
        "abort",
        "cancel"
      ]
    },
    "waiverDecisions": {
      "const": [
        "grant",
        "deny",
        "cancel"
      ]
    },
