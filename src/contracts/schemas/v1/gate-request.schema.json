        "schema_version",
        "gate_id",
        "intent_id",
        "request_digest",
        "task_id",
        "phase_instance",
        "summary",
        "subject_digest",
        "context_digest",
        "current_evidence",
        "opened_at_revision",
        "kind",
        "context",
        "allowed_decisions"
