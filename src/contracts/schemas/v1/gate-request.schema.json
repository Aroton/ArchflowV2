      "required": [
        "origin_gate_id",
        "origin_decision_digest",
        "origin_context_digest",
        "task_id",
        "phase_instance",
        "subject_digest",
        "current_evidence_set_digest",
        "rule",
        "scope"
      ],
      "additionalProperties": false
    },
    "waiverContext": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "origin",
        "rationale"
      ],
      "additionalProperties": false
    },
    "artifactApprovalDecisions": {
      "const": [
        "approve",
        "revise",
        "reject",
        "waiver-requested",
        "cancel"
      ]
    },
    "designApprovalDecisions": {
      "const": [
        "approve",
        "revise",
        "reject",
        "waiver-requested",
        "cancel"
      ]
    },
    "materialDriftDecisions": {
      "const": [
        "amend-upstream",
        "revise-current",
        "reject",
        "cancel"
      ]
    },
    "attemptsExhaustedDecisions": {
      "const": [
        "retry-once",
        "revise",
        "abort",
        "cancel"
      ]
    },
    "reviewPushThroughDecisions": {
      "const": [
        "retry-once",
        "revise",
        "abort",
        "push-through-review",
        "cancel"
      ]
    },
    "validationOverrideDecisions": {
      "const": [
        "grant-validation-override",
        "deny-validation-override",
        "cancel"
      ]
    },
    "constitutionEditDecisions": {
      "const": [
        "revert-edit",
        "start-base-amendment",
        "abort",
        "cancel"
      ]
    },
    "commitAuthorizationDecisions": {
      "const": [
        "authorize-commit",
        "revise",
        "abort",
        "waiver-requested",
        "cancel"
      ]
    },
    "restoreCollisionDecisions": {
      "const": [
        "discard-and-restore",
        "adopt-as-new-generation",
        "abort",
        "cancel"
      ]
    },
    "baselineAdoptionDecisions": {
      "const": [
        "adopt-current-bytes",
        "restore-recorded-bytes",
        "adopt-committed-deletions",
        "abort",
        "cancel"
      ]
    },
    "migrationAuditDecisions": {
      "const": [
        "accept-import-audit",
        "revise",
        "abort",
        "cancel"
      ]
    },
    "waiverDecisions": {
      "const": [
        "grant",
        "deny",
        "cancel"
      ]
    },
    "artifactApproval": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
