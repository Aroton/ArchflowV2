{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:protocol-error",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]{1,64}$"
    },
    "tool": {
      "type": "string",
      "enum": [
        "archflow_state",
        "archflow_counter_review",
        "archflow_gate",
        "archflow_waiver",
        "archflow_status",
        "archflow_apply"
      ]
    },
    "notFound": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "code": {
          "type": "string",
          "const": "TOOL_NOT_FOUND"
        },
        "owner": {
          "type": "string",
          "const": "protocol"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        },
        "diagnostic": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "const": "TOOL_NOT_FOUND"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "tool_name_digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "required": [
                "tool_name_digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "template_id",
            "parameters"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string",
          "const": "call-advertised-tool"
        }
      },
      "required": [
        "schema_version",
        "code",
        "owner",
        "retryable",
        "diagnostic",
        "next_action"
      ],
      "additionalProperties": false
    },
    "disabled": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "code": {
          "type": "string",
          "const": "TOOL_DISABLED"
        },
        "owner": {
          "type": "string",
          "const": "protocol"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        },
        "diagnostic": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "const": "TOOL_DISABLED"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "tool": {
                  "$ref": "#/$defs/tool"
                },
                "lifecycle_state": {
                  "$ref": "#/$defs/code"
                }
              },
              "required": [
                "tool",
                "lifecycle_state"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "template_id",
            "parameters"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string",
          "const": "wait-for-tool-enable"
        }
      },
      "required": [
        "schema_version",
        "code",
        "owner",
        "retryable",
        "diagnostic",
        "next_action"
      ],
      "additionalProperties": false
    },
    "unsupported": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "code": {
          "type": "string",
          "const": "UNSUPPORTED_PROTOCOL"
        },
        "owner": {
          "type": "string",
          "const": "protocol"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        },
        "diagnostic": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "const": "UNSUPPORTED_PROTOCOL"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "offered_version": {
                  "$ref": "#/$defs/version"
                },
                "supported_version": {
                  "$ref": "#/$defs/version"
                }
              },
              "required": [
                "offered_version",
                "supported_version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "template_id",
            "parameters"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string",
          "const": "negotiate-supported-protocol"
        }
      },
      "required": [
        "schema_version",
        "code",
        "owner",
        "retryable",
        "diagnostic",
        "next_action"
      ],
      "additionalProperties": false
    },
    "repeated": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "code": {
          "type": "string",
          "const": "INITIALIZATION_REPEATED"
        },
        "owner": {
          "type": "string",
          "const": "protocol"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        },
        "diagnostic": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "const": "INITIALIZATION_REPEATED"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "connection_id": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "connection_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "template_id",
            "parameters"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string",
          "const": "open-new-connection"
        }
      },
      "required": [
        "schema_version",
        "code",
        "owner",
        "retryable",
        "diagnostic",
        "next_action"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/notFound"
    },
    {
      "$ref": "#/$defs/disabled"
    },
    {
      "$ref": "#/$defs/unsupported"
    },
    {
      "$ref": "#/$defs/repeated"
    }
  ]
}
