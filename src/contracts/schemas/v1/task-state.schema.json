{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:task-state",
  "$defs": {
    "stepStatus": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "failed"
      ]
    },
    "gateKind": {
      "type": "string",
      "enum": [
        "artifact-approval",
        "design-approval",
        "constitution-review",
        "material-drift",
        "attempts-exhausted",
        "constitution-edit",
        "commit-authorization",
        "restore-collision",
        "baseline-adoption",
        "migration-audit"
      ]
    },
    "authoritativeResultRef": {
      "type": "object",
      "properties": {
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "step": {
          "type": "string",
          "enum": [
            "produce",
            "counter_review",
            "triage",
            "adjudicate"
          ]
        },
        "result_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "result_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
        },
        "input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        }
      },
      "required": [
        "phase_instance",
        "step",
        "result_digest",
        "result_id",
        "input_fingerprint"
      ],
      "additionalProperties": false
    },
    "approvalRef": {
      "type": "object",
      "properties": {
        "gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "gate_kind": {
          "$ref": "#/$defs/gateKind"
        },
        "subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "decision_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "resolved_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gate_id",
        "gate_kind",
        "subject_digest",
        "decision_digest",
        "resolved_at_revision"
      ],
      "additionalProperties": false
    },
    "waiverRef": {
      "type": "object",
      "properties": {
        "gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "rule_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
        },
        "rule_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "scope": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "review-trigger",
                "adjudication-failure"
              ]
            },
            "boundary": {
              "type": "string",
              "enum": [
                "subject",
                "phase",
                "task"
              ]
            }
          },
          "required": [
            "operation",
            "boundary"
          ],
          "additionalProperties": false
        },
        "granted": {
          "type": "boolean"
        },
        "expires": {
          "type": "string",
          "const": "task-complete"
        },
        "granted_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gate_id",
        "rule_id",
        "rule_version",
        "subject_digest",
        "scope",
        "granted",
        "expires",
        "granted_at_revision"
      ],
      "additionalProperties": false
    },
    "openGateRef": {
      "type": "object",
      "properties": {
        "gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "gate_kind": {
          "$ref": "#/$defs/gateKind"
        },
        "subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "context_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "frozen_state_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "waiver_origin_gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "opened_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gate_id",
        "gate_kind",
        "subject_digest",
        "context_digest",
        "frozen_state_digest",
        "opened_at_revision"
      ],
      "additionalProperties": false
    },
    "humanRevisionClassification": {
      "type": "string",
      "enum": [
        "simple",
        "significant"
      ]
    },
    "humanRevisionOverride": {
      "type": "object",
      "properties": {
        "agent_classification": {
          "$ref": "#/$defs/humanRevisionClassification"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "agent_classification",
        "rationale"
      ],
      "additionalProperties": false
    },
    "pendingHumanRevision": {
      "type": "object",
      "properties": {
        "gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "gate_kind": {
          "type": "string",
          "enum": [
            "artifact-approval",
            "design-approval",
            "constitution-review",
            "material-drift",
            "attempts-exhausted",
            "commit-authorization",
            "migration-audit"
          ]
        },
        "predecessor_subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "predecessor_input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "requested_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoritativeResultRef"
          }
        }
      },
      "required": [
        "gate_id",
        "gate_kind",
        "predecessor_subject_digest",
        "predecessor_input_fingerprint",
        "requested_at_revision",
        "attempt",
        "evidence"
      ],
      "additionalProperties": false
    },
    "humanRevisionRecord": {
      "type": "object",
      "properties": {
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "gate_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "gate_kind": {
          "type": "string",
          "enum": [
            "artifact-approval",
            "design-approval",
            "constitution-review",
            "material-drift",
            "attempts-exhausted",
            "commit-authorization",
            "migration-audit"
          ]
        },
        "predecessor_subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "predecessor_input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "resulting_subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "resulting_result_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "classification": {
          "$ref": "#/$defs/humanRevisionClassification"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "user_override": {
          "$ref": "#/$defs/humanRevisionOverride"
        },
        "previous_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resulting_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoritativeResultRef"
          }
        }
      },
      "required": [
        "phase_instance",
        "gate_id",
        "gate_kind",
        "predecessor_subject_digest",
        "predecessor_input_fingerprint",
        "resulting_subject_digest",
        "resulting_result_digest",
        "classification",
        "rationale",
        "previous_attempt",
        "resulting_attempt",
        "evidence"
      ],
      "additionalProperties": false
    },
    "planningRestartHumanProvenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1"
            },
            "actor_class": {
              "type": "string",
              "const": "human"
            },
            "assurance": {
              "type": "string",
              "const": "declared-local-trace"
            },
            "channel": {
              "type": "string",
              "const": "connected-host"
            },
            "decision_event_id": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
            },
            "connection_id": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
            },
            "request_id_digest": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "schema_version",
            "actor_class",
            "assurance",
            "channel",
            "decision_event_id",
            "connection_id",
            "request_id_digest",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1"
            },
            "actor_class": {
              "type": "string",
              "const": "human"
            },
            "assurance": {
              "type": "string",
              "const": "declared-local-trace"
            },
            "channel": {
              "type": "string",
              "const": "archflow-local"
            },
            "decision_event_id": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
            },
            "helper_invocation_id": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "schema_version",
            "actor_class",
            "assurance",
            "channel",
            "decision_event_id",
            "helper_invocation_id",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1"
            },
            "actor_class": {
              "type": "string",
              "const": "human"
            },
            "assurance": {
              "type": "string",
              "const": "connected-request-trace"
            },
            "channel": {
              "type": "string",
              "const": "connected-host"
            },
            "connection_id": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
            },
            "invocation_id": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
            },
            "request_id_digest": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
            },
            "request_digest": {
              "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
            }
          },
          "required": [
            "schema_version",
            "actor_class",
            "assurance",
            "channel",
            "connection_id",
            "invocation_id",
            "request_id_digest",
            "request_digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "planningRestartRecord": {
      "type": "object",
      "properties": {
        "restart_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "source_phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "target_phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "restarted_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "superseded_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoritativeResultRef"
          }
        },
        "cleared_waivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waiverRef"
          }
        },
        "cleared_pending_human_revision": {
          "$ref": "#/$defs/pendingHumanRevision"
        },
        "human_provenance": {
          "$ref": "#/$defs/planningRestartHumanProvenance"
        }
      },
      "required": [
        "restart_id",
        "source_phase_instance",
        "target_phase_instance",
        "reason",
        "restarted_at_revision",
        "superseded_results",
        "cleared_waivers",
        "human_provenance"
      ],
      "additionalProperties": false
    },
    "ruleSettlementConclusion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wait": {
              "type": "boolean",
              "const": false
            },
            "match": {
              "type": "null",
              "const": null
            }
          },
          "required": [
            "wait",
            "match"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "wait": {
              "type": "boolean",
              "const": true
            },
            "match": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "subject"
                    },
                    "subject": {
                      "type": "string",
                      "enum": [
                        "prd",
                        "design",
                        "phase-design",
                        "phase-impl"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "subject"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "content"
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "secondary_paths": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "repository": {
                            "type": "string",
                            "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
                          },
                          "paths": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "repository",
                          "paths"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "paths"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "wait",
            "match"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ruleSettlement": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
        },
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
        },
        "step": {
          "type": "string",
          "enum": [
            "produce",
            "counter_review",
            "triage",
            "adjudicate"
          ]
        },
        "subject_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "conclusion": {
          "$ref": "#/$defs/ruleSettlementConclusion"
        },
        "config_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "milestone_baseline_commit": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
        },
        "milestone_target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "milestone_target_head": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
        },
        "secondary_milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "repository_identity_digest": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
              },
              "baseline_commit": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
              },
              "target_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "target_head": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
                }
              },
              "commit_message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "diff_digest": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
              },
              "snapshot_digest": {
                "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
              }
            },
            "required": [
              "repository",
              "repository_identity_digest",
              "baseline_commit",
              "target_ref",
              "target_head",
              "paths",
              "commit_message",
              "diff_digest",
              "snapshot_digest"
            ],
            "additionalProperties": false
          }
        },
        "settled_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "task_id",
        "phase_instance",
        "step",
        "subject_digest",
        "conclusion",
        "config_digest",
        "settled_at_revision"
      ],
      "additionalProperties": false
    },
    "lastTransition": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "tool": {
          "type": "string",
          "enum": [
            "archflow_state",
            "archflow_counter_review",
            "archflow_gate",
            "archflow_waiver"
          ]
        },
        "operation": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeCode"
        },
        "intent_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "request_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "result_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
        },
        "outcome": {
          "$ref": "#/$defs/plainJson"
        },
        "outcome_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "prior_revision": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
        },
        "resulting_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "tool",
        "operation",
        "intent_id",
        "request_digest",
        "input_fingerprint",
        "result_id",
        "outcome",
        "outcome_digest",
        "prior_revision",
        "resulting_revision"
      ],
      "additionalProperties": false
    },
    "plainJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plainJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/plainJson"
          }
        }
      ]
    },
    "configRoute": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "configRoles": {
      "type": "object",
      "properties": {
        "producer": {
          "$ref": "#/$defs/configRoute"
        },
        "counter-reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/configRoute"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/configRoute"
              }
            }
          ]
        },
        "counter-reviewers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/configRoute"
          }
        },
        "test-reviewer": {
          "$ref": "#/$defs/configRoute"
        },
        "effort-reviewer": {
          "$ref": "#/$defs/configRoute"
        },
        "adjudicator": {
          "$ref": "#/$defs/configRoute"
        }
      },
      "additionalProperties": false
    },
    "configOverrides": {
      "type": "object",
      "properties": {
        "explore": {
          "$ref": "#/$defs/configRoles"
        },
        "prd": {
          "$ref": "#/$defs/configRoles"
        },
        "design": {
          "$ref": "#/$defs/configRoles"
        },
        "phase-design": {
          "$ref": "#/$defs/configRoles"
        },
        "phase-impl": {
          "$ref": "#/$defs/configRoles"
        }
      },
      "additionalProperties": false
    },
    "configApprovalRules": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prd",
              "design",
              "phase-design",
              "phase-impl"
            ]
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "paths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subjects",
        "content"
      ],
      "additionalProperties": false
    },
    "configRepositoryMode": {
      "type": "string",
      "enum": [
        "context-only",
        "writable"
      ]
    },
    "configRepositoryName": {
      "type": "string",
      "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "configRepositoryDeclaration": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "$ref": "#/$defs/configRepositoryMode"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "configRepositories": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/configRepositoryName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/configRepositoryDeclaration"
      }
    },
    "configSnapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "roles": {
          "$ref": "#/$defs/configRoles"
        },
        "producers": {
          "type": "object",
          "properties": {
            "claude": {
              "$ref": "#/$defs/configRoles"
            },
            "codex": {
              "$ref": "#/$defs/configRoles"
            },
            "antigravity": {
              "$ref": "#/$defs/configRoles"
            }
          },
          "additionalProperties": false
        },
        "overrides": {
          "$ref": "#/$defs/configOverrides"
        },
        "max_attempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "approval_rules": {
          "$ref": "#/$defs/configApprovalRules"
        },
        "repositories": {
          "$ref": "#/$defs/configRepositories"
        }
      },
      "required": [
        "schema_version",
        "roles"
      ],
      "additionalProperties": false
    },
    "lastSeenRepositoryBinding": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "const": "primary"
            },
            {
              "$ref": "#/$defs/configRepositoryName"
            }
          ]
        },
        "declared_path": {
          "type": "string"
        },
        "repository_identity_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        }
      },
      "required": [
        "name",
        "repository_identity_digest"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "repository_identity_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phase_instance": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
    },
    "step": {
      "type": "string",
      "enum": [
        "produce",
        "counter_review",
        "triage",
        "adjudicate"
      ]
    },
    "status": {
      "$ref": "#/$defs/stepStatus"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "input_fingerprint": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "initialization_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "config_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "workflow_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "constitution_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "policy_base_commit": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
    },
    "authoritative_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authoritativeResultRef"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approvalRef"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiverRef"
      }
    },
    "planned_final_phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "open_gate": {
      "$ref": "#/$defs/openGateRef"
    },
    "pending_human_revision": {
      "$ref": "#/$defs/pendingHumanRevision"
    },
    "human_revision_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanRevisionRecord"
      }
    },
    "restart_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planningRestartRecord"
      }
    },
    "milestone_recovery_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recovery_id": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
          },
          "phase_instance": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
          },
          "cause": {
            "type": "string",
            "enum": [
              "milestone-proof-missing",
              "governing-document-drift"
            ]
          },
          "target_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "target_head": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/gitOid"
          },
          "subject_digest": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
          },
          "recovered_at_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "superseded_results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/authoritativeResultRef"
            }
          },
          "cleared_waivers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/waiverRef"
            }
          },
          "cleared_pending_human_revision": {
            "$ref": "#/$defs/pendingHumanRevision"
          }
        },
        "required": [
          "recovery_id",
          "phase_instance",
          "cause",
          "target_ref",
          "target_head",
          "subject_digest",
          "recovered_at_revision",
          "superseded_results",
          "cleared_waivers"
        ],
        "additionalProperties": false
      }
    },
    "baseline_adoptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate_id": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
          },
          "adopted_at_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "adopted_projections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "path": {
                  "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
                },
                "content_digest": {
                  "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
                }
              },
              "required": [
                "path",
                "content_digest"
              ],
              "additionalProperties": false
            }
          },
          "adopted_absences": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
                },
                {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
                    },
                    "path": {
                      "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
                    }
                  },
                  "required": [
                    "repository",
                    "path"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "gate_id",
          "adopted_at_revision",
          "adopted_projections"
        ],
        "additionalProperties": false
      }
    },
    "rule_settlements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleSettlement"
      }
    },
    "last_seen_config": {
      "$ref": "#/$defs/configSnapshot"
    },
    "last_seen_repository_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lastSeenRepositoryBinding"
      }
    },
    "last_transition": {
      "$ref": "#/$defs/lastTransition"
    },
    "terminal": {
      "type": "string",
      "enum": [
        "complete",
        "abandoned"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "repository_identity_digest",
    "revision",
    "phase_instance",
    "step",
    "status",
    "attempt",
    "input_fingerprint",
    "initialization_digest",
    "config_digest",
    "workflow_digest",
    "constitution_digest",
    "policy_base_commit",
    "authoritative_results",
    "approvals",
    "waivers"
  ],
  "additionalProperties": false
}
