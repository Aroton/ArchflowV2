{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:hazard-registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "anyOf": [
              {
                "type": "string",
                "const": "primary"
              },
              {
                "$ref": "urn:archflow:schema:v1:config#/$defs/repositoryName"
              }
            ]
          },
          "path": {
            "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "repository",
          "path",
          "score",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "hazards"
  ],
  "additionalProperties": false
}
