{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:maintenance-record",
  "$defs": {
    "maintenanceDeletion": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "path": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
        },
        "byte_count": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
        },
        "category": {
          "type": "string",
          "enum": [
            "unreferenced-attempt",
            "superseded-payload",
            "retired-intent",
            "retired-staged-request"
          ]
        }
      },
      "required": [
        "digest",
        "path",
        "byte_count",
        "category"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "maintenance_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "performed_at_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "human_reason": {
      "type": "string",
      "minLength": 1
    },
    "reachability_proof_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "deletions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/maintenanceDeletion"
      }
    },
    "total_bytes_deleted": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    }
  },
  "required": [
    "schema_version",
    "maintenance_id",
    "task_id",
    "performed_at_revision",
    "human_reason",
    "reachability_proof_digest",
    "deletions",
    "total_bytes_deleted"
  ],
  "additionalProperties": false
}
