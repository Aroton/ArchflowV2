{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:result-manifest",
  "$defs": {
    "reviewEvidenceArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "artifact_kind": {
          "type": "string",
          "const": "review-evidence"
        },
        "evidence": {
          "$ref": "urn:archflow:schema:v1:review-evidence"
        }
      },
      "required": [
        "schema_version",
        "artifact_kind",
        "evidence"
      ],
      "additionalProperties": false
    },
    "triageArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "artifact_kind": {
          "type": "string",
          "const": "triage"
        },
        "evidence": {
          "$ref": "urn:archflow:schema:v1:triage"
        }
      },
      "required": [
        "schema_version",
        "artifact_kind",
        "evidence"
      ],
      "additionalProperties": false
    },
    "adjudicationEvidenceArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "artifact_kind": {
          "type": "string",
          "const": "adjudication-evidence"
        },
        "evidence": {
          "$ref": "urn:archflow:schema:v1:adjudication-evidence"
        }
      },
      "required": [
        "schema_version",
        "artifact_kind",
        "evidence"
      ],
      "additionalProperties": false
    },
    "projectionDigestRef": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "urn:archflow:schema:v1:durable-primitives#/$defs/repositoryName"
        },
        "path": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
        },
        "content_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        }
      },
      "required": [
        "path",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "secondaryProjectionSet": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "urn:archflow:schema:v1:durable-primitives#/$defs/repositoryName"
        },
        "repository_identity_digest": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
        },
        "projections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectionDigestRef"
          }
        }
      },
      "required": [
        "repository",
        "repository_identity_digest",
        "projections"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "repository_identity_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "result_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId"
    },
    "phase_instance": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
    },
    "step": {
      "type": "string",
      "enum": [
        "produce",
        "counter_review",
        "triage",
        "adjudicate"
      ]
    },
    "artifact_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "source_artifact": {
      "anyOf": [
        {
          "$ref": "urn:archflow:schema:v1:document-artifact"
        },
        {
          "$ref": "urn:archflow:schema:v1:implementation-output"
        },
        {
          "$ref": "#/$defs/reviewEvidenceArtifact"
        },
        {
          "$ref": "#/$defs/triageArtifact"
        },
        {
          "$ref": "#/$defs/adjudicationEvidenceArtifact"
        }
      ]
    },
    "input_fingerprint": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "snapshot_digest": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/sha256Digest"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "urn:archflow:schema:v1:durable-primitives#/$defs/outputEntry"
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectionDigestRef"
      }
    },
    "secondary_projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secondaryProjectionSet"
      }
    },
    "accounting": {
      "$ref": "urn:archflow:schema:v1:durable-primitives#/$defs/snapshotAccounting"
    },
    "secret_scan": {
      "$ref": "urn:archflow:schema:v1:secret-scan-result"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "repository_identity_digest",
    "result_id",
    "phase_instance",
    "step",
    "artifact_digest",
    "source_artifact",
    "input_fingerprint",
    "snapshot_digest",
    "outputs",
    "projections",
    "accounting",
    "secret_scan"
  ],
  "additionalProperties": false
}
