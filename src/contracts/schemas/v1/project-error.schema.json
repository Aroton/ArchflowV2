    "E_REPOSITORY_VIEW_UNAVAILABLE": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "code": {
          "type": "string",
          "const": "REPOSITORY_VIEW_UNAVAILABLE"
        },
        "owner": {
          "type": "string",
          "const": "repository"
        },
        "retryable": {
          "type": "boolean",
          "const": true
        },
        "diagnostic": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "const": "REPOSITORY_VIEW_UNAVAILABLE"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "repository_name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "primary"
                    },
                    {
                      "type": "string",
                      "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
                    }
                  ]
                }
              },
              "required": [
                "repository_name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "template_id",
            "parameters"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string",
          "const": "repair-repository-view-and-resume"
