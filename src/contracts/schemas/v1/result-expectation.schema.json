{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.dev/schemas/v1/result-expectation",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "tool": {
      "type": "string",
      "enum": [
        "archflow_state",
        "archflow_counter_review",
        "archflow_gate",
        "archflow_waiver"
      ]
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "intent_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "resulting_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "success": {}
  },
  "required": [
    "schema_version",
    "tool",
    "task_id",
    "intent_id",
    "input_fingerprint",
    "request_digest",
    "result_id",
    "resulting_revision",
    "success"
  ],
  "additionalProperties": false
}
