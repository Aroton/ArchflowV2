{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.dev/schemas/v1/result-expectation",
  "type": "object",
  "x-archflow-result-expectation-semantics": true,
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeId" },
    "taskSlug": { "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug" },
    "pathSafeId": { "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId" },
    "integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool",
        "task_id",
        "intent_id",
        "input_fingerprint",
        "request_digest",
        "result_id",
        "resulting_revision",
        "success"
      ],
      "properties": {
        "schema_version": { "const": "1" },
        "tool": {
          "enum": [
            "archflow_state",
            "archflow_counter_review",
            "archflow_adjudicate",
            "archflow_gate",
            "archflow_waiver"
          ]
        },
        "task_id": { "$ref": "#/$defs/taskSlug" },
        "intent_id": { "$ref": "#/$defs/pathSafeId" },
        "input_fingerprint": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "result_id": { "$ref": "#/$defs/id" },
        "resulting_revision": { "$ref": "#/$defs/integer" },
        "success": { "type": "object" }
      }
    },
    "archflow_state": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "properties": {
            "tool": { "const": "archflow_state" },
            "success": {
              "$ref": "https://archflow.dev/schemas/v1/mcp-tools#/$defs/archflow_state/success"
            }
          }
        }
      ]
    },
    "archflow_counter_review": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "properties": {
            "tool": { "const": "archflow_counter_review" },
            "success": {
              "$ref": "https://archflow.dev/schemas/v1/mcp-tools#/$defs/archflow_counter_review/success"
            }
          }
        }
      ]
    },
    "archflow_adjudicate": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "properties": {
            "tool": { "const": "archflow_adjudicate" },
            "success": {
              "$ref": "https://archflow.dev/schemas/v1/mcp-tools#/$defs/archflow_adjudicate/success"
            }
          }
        }
      ]
    },
    "archflow_gate": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "properties": {
            "tool": { "const": "archflow_gate" },
            "success": {
              "$ref": "https://archflow.dev/schemas/v1/mcp-tools#/$defs/archflow_gate/success"
            }
          }
        }
      ]
    },
    "archflow_waiver": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "properties": {
            "tool": { "const": "archflow_waiver" },
            "success": {
              "$ref": "https://archflow.dev/schemas/v1/mcp-tools#/$defs/archflow_waiver/success"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/archflow_state" },
    { "$ref": "#/$defs/archflow_counter_review" },
    { "$ref": "#/$defs/archflow_adjudicate" },
    { "$ref": "#/$defs/archflow_gate" },
    { "$ref": "#/$defs/archflow_waiver" }
  ]
}
