{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:implementation-profiles",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "model": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "effort": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "profile_id",
          "model",
          "enabled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "profiles"
  ],
  "additionalProperties": false
}
