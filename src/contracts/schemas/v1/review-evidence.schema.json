{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:review-evidence",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "task_id": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/taskSlug"
        },
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/phaseInstance"
        },
        "step": {
          "type": "string",
          "const": "counter_review"
        },
        "role": {
          "type": "string",
          "enum": [
            "counter-review",
            "gate-counter-review"
          ]
        },
        "subject_digest": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "rubric_digest": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "producer_family": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "urn:archflow:schema:v1:review#/$defs/finding"
          }
        },
        "matched_rule_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "$ref": "urn:archflow:schema:v1:review#/$defs/id"
              },
              "rule_version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "rule_id",
              "rule_version"
            ],
            "additionalProperties": false
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "advisory",
            "fail"
          ]
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_family": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/nonBlank"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "assurance": {
          "type": "string",
          "const": "server-attested"
        },
        "adapter": {
          "type": "string",
          "enum": [
            "claude-cli",
            "codex-cli"
          ]
        },
        "cli_version": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/nonBlank"
        },
        "invocation_id": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/id"
        },
        "envelope_input_digest": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "observed_output_digest": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "result_id": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/id"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "phase_instance",
        "step",
        "role",
        "subject_digest",
        "input_fingerprint",
        "rubric_digest",
        "producer_family",
        "findings",
        "matched_rule_versions",
        "verdict",
        "blocking_count",
        "model_family",
        "model",
        "effort",
        "assurance",
        "adapter",
        "cli_version",
        "invocation_id",
        "envelope_input_digest",
        "observed_output_digest",
        "result_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "task_id": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/taskSlug"
        },
        "phase_instance": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/phaseInstance"
        },
        "step": {
          "type": "string",
          "const": "counter_review"
        },
        "role": {
          "type": "string",
          "enum": [
            "counter-review",
            "gate-counter-review"
          ]
        },
        "subject_digest": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "input_fingerprint": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "rubric_digest": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/digest"
        },
        "producer_family": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "urn:archflow:schema:v1:review#/$defs/finding"
          }
        },
        "matched_rule_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "$ref": "urn:archflow:schema:v1:review#/$defs/id"
              },
              "rule_version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "rule_id",
              "rule_version"
            ],
            "additionalProperties": false
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "advisory",
            "fail"
          ]
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_family": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "claude",
                "codex"
              ]
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "model": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/nonBlank"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "assurance": {
          "type": "string",
          "const": "degraded"
        },
        "reason": {
          "$ref": "urn:archflow:schema:v1:review#/$defs/nonBlank"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "phase_instance",
        "step",
        "role",
        "subject_digest",
        "input_fingerprint",
        "rubric_digest",
        "producer_family",
        "findings",
        "matched_rule_versions",
        "verdict",
        "blocking_count",
        "model_family",
        "model",
        "effort",
        "assurance",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
