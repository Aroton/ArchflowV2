              }
            },
            "required": [
              "upstream_digest",
              "drift",
              "affected_claim_ids",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "constitution": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "uncertain"
          ]
        },
        "drift": {
          "type": "string",
          "enum": [
            "aligned",
            "incidental",
            "material"
          ]
        },
        "matched_rule_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "rule_version": {
                "type": "integer",
