{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:release-manifest",
  "title": "ArchFlow Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_digest",
    "dependency_inventory_digest",
    "bundle_inputs",
    "contributing_inputs",
    "release_control_inputs",
    "runtime_assets",
    "dependency_provenance_inputs",
    "proof_inputs",
    "declared_content",
    "build_entries",
    "entry_provenance",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "dependency_inventory_digest": { "$ref": "#/$defs/digest" },
    "bundle_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundle_input" },
      "x-archflow-unique-by": "key"
    },
    "contributing_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/metafile_key" },
      "x-archflow-sorted-unique": true
    },
    "release_control_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository_file" },
      "x-archflow-unique-by": "path"
    },
    "runtime_assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository_file" },
      "x-archflow-unique-by": "path"
    },
    "dependency_provenance_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency_file" },
      "x-archflow-unique-by": ["package_name", "package_version", "package_relative_path"]
    },
    "proof_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/portable_path" },
      "x-archflow-sorted-unique": true
    },
    "declared_content": { "$ref": "#/$defs/declared_content" },
    "build_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/build_entry" },
      "x-archflow-unique-by": "id"
    },
    "entry_provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/entry_provenance" },
      "x-archflow-unique-by": "id"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" },
      "x-archflow-unique-by": "path"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "metafile_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "package_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:@[^/\\s]+/)?[^/\\s]+$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
    },
    "repository_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "repository" },
        "path": { "$ref": "#/$defs/portable_path" }
      }
    },
    "dependency_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "package_name", "package_version", "package_relative_path"],
      "properties": {
        "kind": { "const": "dependency" },
        "package_name": { "$ref": "#/$defs/package_name" },
        "package_version": { "$ref": "#/$defs/package_version" },
        "package_relative_path": { "$ref": "#/$defs/portable_path" }
      }
    },
    "bundle_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "origin", "size", "digest", "bytes_in_output"],
      "properties": {
        "key": { "$ref": "#/$defs/metafile_key" },
        "origin": {
          "oneOf": [
            { "$ref": "#/$defs/repository_origin" },
            { "$ref": "#/$defs/dependency_origin" }
          ]
        },
        "size": { "$ref": "#/$defs/byte_size" },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes_in_output": { "$ref": "#/$defs/byte_size" }
      }
    },
    "repository_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/portable_path" },
        "size": { "$ref": "#/$defs/byte_size" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "dependency_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "package_version", "package_relative_path", "purpose", "size", "digest"],
      "properties": {
        "package_name": { "$ref": "#/$defs/package_name" },
        "package_version": { "$ref": "#/$defs/package_version" },
        "package_relative_path": { "$ref": "#/$defs/portable_path" },
        "purpose": {
          "enum": ["package-manifest", "license", "notice"]
        },
        "size": { "$ref": "#/$defs/byte_size" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "declared_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemas", "constitution"],
      "properties": {
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/portable_path" },
          "x-archflow-sorted-unique": true
        },
        "constitution": {
          "type": "array",
          "items": { "$ref": "#/$defs/portable_path" },
          "x-archflow-sorted-unique": true
        }
      }
    },
    "build_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "entry_point", "output_path", "handler_authority"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "role": { "const": "local-cli" },
        "entry_point": { "$ref": "#/$defs/portable_path" },
        "output_path": { "$ref": "#/$defs/portable_path" },
        "handler_authority": { "const": "local-cli-handler" }
      }
    },
    "entry_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry_point", "output_path", "output_digest", "contributing_inputs", "allowed_imports"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "entry_point": { "$ref": "#/$defs/portable_path" },
        "output_path": { "$ref": "#/$defs/portable_path" },
        "output_digest": { "$ref": "#/$defs/digest" },
        "contributing_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metafile_key" },
          "x-archflow-sorted-unique": true
        },
        "allowed_imports": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "x-archflow-sorted-unique": true
        }
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "role"],
          "properties": {
            "path": { "const": "manifest.json" },
            "role": { "const": "manifest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "role", "size", "digest"],
          "properties": {
            "path": { "$ref": "#/$defs/portable_path" },
            "role": { "enum": ["executable", "metafile", "legal-notice", "upstream-legal"] },
            "size": { "$ref": "#/$defs/byte_size" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    }
  }
}
