        },
        "context_digest": {
          "$ref": "urn:archflow:schema:v1:gate-contract#/$defs/digest"
        },
        "human_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/connected"
            },
            {
              "$ref": "#/$defs/local"
