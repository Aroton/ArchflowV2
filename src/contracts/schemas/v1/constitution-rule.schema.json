{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:constitution-rule",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated"
      ]
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "enforced_by": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "text"
  ],
  "additionalProperties": false
}
