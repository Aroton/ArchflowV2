{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:constitution-rule",
  "type": "object", "additionalProperties": false,
  "required": ["id", "version", "status", "text"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }, "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "status": { "enum": ["active", "deprecated"] }, "text": { "type": "string", "minLength": 1, "pattern": "\\S" }, "review_trigger": { "type": "string", "minLength": 1, "pattern": "\\S" }, "enforced_by": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
  }
}
