{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:component-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "repositories": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "primary"
                    },
                    {
                      "$ref": "urn:archflow:schema:v1:config#/$defs/repositoryName"
                    }
                  ]
                },
                "paths": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "urn:archflow:schema:v1:primitives#/$defs/repositoryPathClaim"
                  }
                }
              },
              "required": [
                "name",
                "paths"
              ],
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "name",
          "scope",
          "mechanism",
          "repositories",
          "verification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "components"
  ],
  "additionalProperties": false
}
