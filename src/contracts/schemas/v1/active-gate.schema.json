        "request_digest",
        "task_id",
        "phase_instance",
        "summary",
        "subject_digest",
        "context_digest",
        "current_evidence",
        "opened_at_revision",
        "status",
        "decision_template",
        "kind",
        "context",
        "allowed_decisions"
