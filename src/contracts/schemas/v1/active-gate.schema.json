          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "intent_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/pathSafeId"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
        },
        "phase_instance": {
          "type": "string",
          "pattern": "^(?:prd|design|phase-(?:design|impl)-[1-9][0-9]*)$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_evidence": {
          "$ref": "urn:archflow:schema:v1:gate-request#/$defs/currentEvidence"
        },
        "supersedes": {
          "$ref": "urn:archflow:schema:v1:gate-request#/$defs/supersession"
        },
        "opened_at_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "const": "awaiting-human"
        },
        "decision_template": {
          "$ref": "#/$defs/decisionTemplate"
        },
        "supplemental": {
          "$ref": "urn:archflow:schema:v1:gate-decision-record#/$defs/supplemental"
        },
        "kind": {
          "type": "string",
          "const": "constitution-review"
        },
        "context": {
          "$ref": "urn:archflow:schema:v1:gate-request#/$defs/waiverContext"
        },
        "allowed_decisions": {
          "$ref": "urn:archflow:schema:v1:gate-request#/$defs/waiverDecisions"
        }
      },
      "required": [
        "schema_version",
        "gate_id",
        "intent_id",
        "request_digest",
        "task_id",
        "phase_instance",
        "summary",
        "subject_digest",
        "context_digest",
        "current_evidence",
        "opened_at_revision",
        "status",
        "decision_template",
        "supplemental",
        "kind",
        "context",
        "allowed_decisions"
      ],
      "additionalProperties": false
    }
  ]
}
