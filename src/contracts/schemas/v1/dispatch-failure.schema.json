{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:dispatch-failure",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "phase_instance": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
    },
    "step": {
      "type": "string",
      "const": "counter_review"
    },
    "attempt": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    },
    "role": {
      "type": "string",
      "enum": [
        "counter-reviewer",
        "adjudicator"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "CONFIG_INVALID",
        "CONFIG_MODEL_UNSUPPORTED",
        "CLI_MISSING",
        "AUTH_UNAVAILABLE",
        "RATE_LIMITED",
        "UNSUPPORTED_MODEL",
        "CLI_VERSION_UNSUPPORTED",
        "PROCESS_FAILED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "route": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "enum": [
            "configured",
            "invocation-declared",
            "route-override"
          ]
        }
      },
      "required": [
        "model",
        "effort",
        "source"
      ],
      "additionalProperties": false
    },
    "observed_at_revision": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "phase_instance",
    "step",
    "attempt",
    "role",
    "code",
    "message",
    "observed_at_revision"
  ],
  "additionalProperties": false
}
