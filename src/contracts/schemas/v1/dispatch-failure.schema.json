{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:dispatch-failure",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/taskSlug"
    },
    "phase_instance": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/phaseInstanceId"
    },
    "step": {
      "type": "string",
      "const": "counter_review"
    },
    "attempt": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    },
    "role": {
      "type": "string",
      "enum": [
        "counter-reviewer",
        "test-reviewer",
        "effort-reviewer",
        "adjudicator"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "CONFIG_INVALID",
        "CONFIG_MODEL_UNSUPPORTED",
        "CLI_MISSING",
        "AUTH_UNAVAILABLE",
        "RATE_LIMITED",
        "UNSUPPORTED_MODEL",
        "CLI_VERSION_UNSUPPORTED",
        "PROCESS_FAILED",
        "REPOSITORY_VIEW_UNAVAILABLE"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repository_name": {
      "anyOf": [
        {
          "type": "string",
          "const": "primary"
        },
        {
          "type": "string",
          "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
        }
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "enum": [
            "configured",
            "invocation-declared",
            "route-override"
          ]
        }
      },
      "required": [
        "model",
        "effort",
        "source"
      ],
      "additionalProperties": false
    },
    "observed_at_revision": {
      "$ref": "urn:archflow:schema:v1:primitives#/$defs/safeInteger"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "phase_instance",
    "step",
    "attempt",
    "role",
    "code",
    "message",
    "observed_at_revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "REPOSITORY_VIEW_UNAVAILABLE"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "repository_name": {}
        },
        "required": [
          "repository_name"
        ]
      },
      "else": {
        "not": {
          "properties": {
            "repository_name": {}
          },
          "required": [
            "repository_name"
          ]
        }
      }
    }
  ]
}
