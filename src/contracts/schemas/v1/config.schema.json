{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:config",
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "producer": {
          "$ref": "#/$defs/route"
        },
        "counter-reviewer": {
          "$ref": "#/$defs/route"
        },
        "adjudicator": {
          "$ref": "#/$defs/route"
        }
      },
      "additionalProperties": false
    },
    "overrides": {
      "type": "object",
      "properties": {
        "explore": {
          "$ref": "#/$defs/roles"
        },
        "prd": {
          "$ref": "#/$defs/roles"
        },
        "design": {
          "$ref": "#/$defs/roles"
        },
        "phase-design": {
          "$ref": "#/$defs/roles"
        },
        "phase-impl": {
          "$ref": "#/$defs/roles"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "roles": {
      "$ref": "#/$defs/roles"
    },
    "overrides": {
      "$ref": "#/$defs/overrides"
    },
    "max_attempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "roles"
  ],
  "additionalProperties": false
}
