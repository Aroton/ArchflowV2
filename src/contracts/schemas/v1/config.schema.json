{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:config",
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "producer": {
          "$ref": "#/$defs/route"
        },
        "counter-reviewer": {
          "$ref": "#/$defs/route"
        },
        "adjudicator": {
          "$ref": "#/$defs/route"
        }
      },
      "additionalProperties": false
    },
    "overrides": {
      "type": "object",
      "properties": {
        "explore": {
          "$ref": "#/$defs/roles"
        },
        "prd": {
          "$ref": "#/$defs/roles"
        },
        "design": {
          "$ref": "#/$defs/roles"
        },
        "phase-design": {
          "$ref": "#/$defs/roles"
        },
        "phase-impl": {
          "$ref": "#/$defs/roles"
        }
      },
      "additionalProperties": false
    },
    "repositoryMode": {
      "type": "string",
      "enum": [
        "context-only",
        "writable"
      ]
    },
    "repositoryName": {
      "type": "string",
      "pattern": "^(?!primary$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?$)(?!.*[. ]$)[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "repositoryDeclaration": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "$ref": "#/$defs/repositoryMode"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/repositoryName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/repositoryDeclaration"
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "roles": {
      "$ref": "#/$defs/roles"
    },
    "overrides": {
      "$ref": "#/$defs/overrides"
    },
    "max_attempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "approval_rules": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prd",
              "design",
              "phase-design",
              "phase-impl"
            ]
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "paths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subjects",
        "content"
      ],
      "additionalProperties": false
    },
    "repositories": {
      "$ref": "#/$defs/repositories"
    }
  },
  "required": [
    "schema_version",
    "roles"
  ],
  "additionalProperties": false
}
