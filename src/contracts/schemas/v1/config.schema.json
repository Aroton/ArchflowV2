{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:config",
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "producer": {
          "$ref": "#/$defs/route"
        },
        "counter-reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/route"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/route"
              }
            }
          ]
        },
        "counter-reviewers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "test-reviewer": {
          "$ref": "#/$defs/route"
        },
        "effort-reviewer": {
          "$ref": "#/$defs/route"
        },
        "adjudicator": {
          "$ref": "#/$defs/route"
        }
      },
      "additionalProperties": false
    },
    "overrides": {
      "type": "object",
      "properties": {
        "explore": {
          "$ref": "#/$defs/roles"
        },
        "prd": {
          "$ref": "#/$defs/roles"
        },
        "design": {
          "$ref": "#/$defs/roles"
        },
        "phase-design": {
          "$ref": "#/$defs/roles"
        },
        "phase-impl": {
          "$ref": "#/$defs/roles"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "roles": {
      "$ref": "#/$defs/roles"
    },
    "producers": {
      "type": "object",
      "properties": {
        "claude": {
          "$ref": "#/$defs/roles"
        },
        "codex": {
          "$ref": "#/$defs/roles"
        },
        "antigravity": {
          "$ref": "#/$defs/roles"
        }
      },
      "additionalProperties": false
    },
    "overrides": {
      "$ref": "#/$defs/overrides"
    },
    "approval_rules": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prd",
              "design",
              "phase-design",
              "phase-impl"
            ]
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "paths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subjects",
        "content"
      ],
      "additionalProperties": false
    },
    "max_attempts": {},
    "repositories": {},
    "implementation": {}
  },
  "required": [
    "schema_version",
    "roles"
  ],
  "additionalProperties": false
}
