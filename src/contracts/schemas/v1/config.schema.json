{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archflow:schema:v1:config",
  "$defs": {
    "route": { "type": "object", "additionalProperties": false, "required": ["model", "effort"], "properties": { "model": { "type": "string", "minLength": 1, "pattern": "\\S" }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] } } },
    "roles": { "type": "object", "additionalProperties": false, "properties": { "producer": { "$ref": "#/$defs/route" }, "self-reviewer": { "$ref": "#/$defs/route" }, "counter-reviewer": { "$ref": "#/$defs/route" }, "adjudicator": { "$ref": "#/$defs/route" } } },
    "overrides": { "type": "object", "additionalProperties": false, "properties": { "explore": { "$ref": "#/$defs/roles" }, "prd": { "$ref": "#/$defs/roles" }, "design": { "$ref": "#/$defs/roles" }, "phase-design": { "$ref": "#/$defs/roles" }, "phase-impl": { "$ref": "#/$defs/roles" } } }
  },
  "type": "object", "additionalProperties": false, "required": ["schema_version", "roles"],
  "properties": { "schema_version": { "const": "1" }, "roles": { "$ref": "#/$defs/roles" }, "overrides": { "$ref": "#/$defs/overrides" }, "max_attempts": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } }
}
